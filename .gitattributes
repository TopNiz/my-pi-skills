# Keep shell scripts LF so they stay executable when the repo is cloned on
# Windows (Git Bash) — a CRLF shebang breaks "bad interpreter".
*.sh text eol=lf

# Python sources stay LF as well.
*.py text eol=lf

# Lockfiles are generated and must not be rewritten by line-ending filters.
uv.lock -text
*.whl binary

# The freebox skill vendors the FreeboxOS API reference generated by the box
# itself (freebox/docs/). It is a build artifact, so keep the bytes exactly as
# served — a line-ending filter would silently rewrite it on every Windows
# checkout.
freebox/docs/** -text
