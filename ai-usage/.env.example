# AI Usage — API Keys
# Copy this file to ~/.pi/agent/.env and fill in your keys
# Security: chmod 600 ~/.pi/agent/.env

OPENAI_ADMIN_KEY=sk-admin-your-openai-admin-key-here
DEEPSEEK_KEY=sk-your-deepseek-api-key-here
OLLAMA_CLOUD_KEY=your-ollama-cloud-api-key-here

# Infrastructure — set per machine
# OLLAMA_SERVER_URL=http://your-server:11434/v1
