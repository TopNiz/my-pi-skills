# Local template library for the `powerpoint` skill.
#
# Copy to `.env` in this skill directory and set the path for this machine:
#     cp .env.example .env
#
# These decks are NOT part of the skill and are never committed, shipped or
# advertised: they are third-party branded templates whose redistribution is
# not permitted. The skill consults them only as *reference material* — to
# read off layout composition, geometry, palette and typography patterns.
# They are not editorial sources and must never be delivered as output.
#
# Point this at the directory that holds the template decks. A tilde is
# expanded, so `~/Documents/Templates` is valid.
POWERPOINT_TEMPLATES_DIR=~/Documents/Templates
